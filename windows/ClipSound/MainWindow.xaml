<Window x:Class="ClipSound.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:ClipSound"
        Title="ClipSound" Width="1180" Height="760" MinWidth="560" MinHeight="460"
        AllowDrop="True" Icon="AppIcon.ico" Focusable="True" FocusVisualStyle="{x:Null}"
        FontFamily="{StaticResource TextFont}" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Kachelgröße (Darstellung → Klein/Mittel/Groß), wird im Code umgestellt -->
        <sys:Double x:Key="TileMinWidth">188</sys:Double>
        <sys:Double x:Key="TileHeight">112</sys:Double>
        <sys:Double x:Key="TileFontSize">14</sys:Double>
        <sys:Double x:Key="TileIconSize">18</sys:Double>
        <sys:Double x:Key="TileTitleMaxHeight">40</sys:Double>
        <Thickness x:Key="TilePadding">13,12,13,12</Thickness>

        <!-- Eine Sound-Kachel: Farbverlauf wie am Mac, Taste als kleine Fläche oben rechts -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:TileViewModel}">
            <Grid x:Name="Root" Cursor="Hand" Background="Transparent" ToolTip="{Binding FileName}"
                  MouseLeftButtonDown="Tile_MouseDown">
                <Grid.ContextMenu>
                    <!-- Einträge kommen aus dem Code (Lobby: Behalten / Schenken an) -->
                    <ContextMenu Opened="TileMenu_Opened"/>
                </Grid.ContextMenu>
                <Border x:Name="Card" CornerRadius="8" BorderThickness="1" BorderBrush="#1FFFFFFF" Background="{Binding TileBrush}">
                    <Grid>
                        <Border x:Name="Hover" CornerRadius="7" Background="#18FFFFFF" Visibility="Collapsed"/>
                        <Grid Margin="{DynamicResource TilePadding}">
                            <TextBlock x:Name="Icon" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" Foreground="White"
                                       FontSize="{DynamicResource TileIconSize}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource TileFontSize}" FontWeight="SemiBold"
                                       Foreground="White" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       MaxHeight="{DynamicResource TileTitleMaxHeight}" VerticalAlignment="Bottom"/>
                        </Grid>
                        <local:ProgressLine x:Name="Progress" Height="4" Margin="13,0,13,6" VerticalAlignment="Bottom"
                                            Progress="{Binding Progress}" Fill="White" Track="#4DFFFFFF" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Taste -->
                <Button x:Name="KeyButton" Style="{StaticResource KeyBadge}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="9" Click="Key_Click" ToolTip="{Binding KeyToolTip}"
                        Visibility="{Binding HasKey, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="GlobalIcon" Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="FailedIcon" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed" Foreground="#FFFCE100"/>
                        <TextBlock Text="{Binding KeyText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Noch keine Taste: beim Drüberfahren anbieten -->
                <Button x:Name="AddKeyButton" Style="{StaticResource KeyBadge}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="9" Click="Key_Click" ToolTip="Taste festlegen" Visibility="Collapsed">
                    <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                </Button>
            </Grid>

            <DataTemplate.Triggers>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="AddKeyButton" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Card" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.28" Color="Black"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <DataTrigger Binding="{Binding HasKey}" Value="True">
                    <Setter TargetName="AddKeyButton" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLobby}" Value="True">
                    <Setter TargetName="AddKeyButton" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HotKeyState}" Value="global">
                    <Setter TargetName="GlobalIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HotKeyState}" Value="failed">
                    <Setter TargetName="FailedIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#B3FFFFFF"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="Icon" Property="Text" Value="&#xE995;"/>
                    <Setter TargetName="Progress" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TilePanel">
            <local:TileGrid MinTileWidth="{DynamicResource TileMinWidth}" TileHeight="{DynamicResource TileHeight}" Spacing="12"/>
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid x:Name="Shell">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Navigationsleiste (wie NavigationView) ================= -->
        <Grid x:Name="Pane" Width="280" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button x:Name="HamburgerBtn" Style="{StaticResource SubtleButton}" Width="40" Height="36" Margin="4,4,0,2"
                    HorizontalAlignment="Left" Click="Hamburger_Click" ToolTip="Navigation ein- oder ausklappen">
                <TextBlock Text="&#xE700;" Style="{StaticResource Glyph}"/>
            </Button>

            <!-- Suche oben in der Leiste (wie in den Windows-Einstellungen) -->
            <Grid x:Name="SearchBox" Grid.Row="1" Margin="12,4,12,10" Tag="wide">
                <TextBox x:Name="Search" TextChanged="Search_TextChanged" VerticalContentAlignment="Center" Padding="10,5,34,6"/>
                <TextBlock x:Name="SearchPlaceholder" Text="Sounds suchen" Margin="12,0,0,1" VerticalAlignment="Center"
                           IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="14" HorizontalAlignment="Right" Margin="0,0,12,0"
                           IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Grid>
            <Button x:Name="SearchIconBtn" Grid.Row="1" Style="{StaticResource SubtleButton}" Width="40" Height="36" Margin="4,0,0,6"
                    HorizontalAlignment="Left" Click="SearchIcon_Click" ToolTip="Suchen (Strg+F)" Visibility="Collapsed">
                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}"/>
            </Button>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <TextBlock x:Name="HdrLibrary" Text="Bibliothek" Style="{StaticResource NavHeader}" Margin="18,2,0,4" Tag="wide"/>
                    <RadioButton x:Name="NavSounds" Style="{StaticResource NavItem}" Checked="Nav_Checked" ToolTip="Sounds">
                        <DockPanel>
                            <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" Width="20" Margin="0,0,14,0"/>
                            <Border x:Name="SoundsBadge" DockPanel.Dock="Right" Style="{StaticResource NavBadge}" Tag="wide">
                                <TextBlock x:Name="SoundsBadgeText" Text="0" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Sounds" VerticalAlignment="Center" Tag="wide"/>
                        </DockPanel>
                    </RadioButton>

                    <TextBlock x:Name="HdrTogether" Text="Zusammen" Style="{StaticResource NavHeader}" Tag="wide"/>
                    <RadioButton x:Name="NavLobby" Style="{StaticResource NavItem}" Checked="Nav_Checked" ToolTip="Lobby">
                        <DockPanel>
                            <Grid Width="20" Margin="0,0,14,0">
                                <TextBlock Text="&#xE716;" Style="{StaticResource Glyph}"/>
                                <Ellipse x:Name="LobbyNavDot" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Margin="0,0,-2,6" Visibility="Collapsed" Fill="{DynamicResource SystemFillColorSuccessBrush}"/>
                            </Grid>
                            <Border x:Name="LobbyBadge" DockPanel.Dock="Right" Style="{StaticResource NavBadge}" Visibility="Collapsed" Tag="wide">
                                <TextBlock x:Name="LobbyBadgeText" FontFamily="{StaticResource MonoFont}"/>
                            </Border>
                            <TextBlock Text="Lobby" VerticalAlignment="Center" Tag="wide"/>
                        </DockPanel>
                    </RadioButton>

                    <TextBlock x:Name="HdrClans" Text="Clans" Style="{StaticResource NavHeader}" Tag="wide"/>
                    <!-- Clans kommen aus dem Code -->
                    <StackPanel x:Name="ClanNav"/>
                    <Button x:Name="AddClanBtn" Style="{StaticResource SubtleButton}" Margin="4,1" Height="36" Padding="14,0,12,0"
                            HorizontalContentAlignment="Left" Click="AddClan_Click" ToolTip="Clans">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" Width="20" Margin="0,0,14,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="AddClanText" Text="Anmelden für Clans …" VerticalAlignment="Center" Tag="wide"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Unten: Konto und Einstellungen -->
            <StackPanel Grid.Row="3" Margin="0,4,0,6">
                <RadioButton x:Name="NavAccount" Style="{StaticResource NavItem}" Checked="Nav_Checked" MinHeight="52" Padding="10,0,12,0"
                             ToolTip="Konto &amp; Clans">
                    <DockPanel>
                        <ContentControl x:Name="AccountAvatarHost" Width="32" Height="32" Margin="0,0,10,0" Focusable="False"/>
                        <StackPanel VerticalAlignment="Center" Tag="wide">
                            <TextBlock x:Name="AccountName" Text="Anmelden" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="AccountSub" Text="Für Clans mit Freunden" Style="{StaticResource Caption}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </RadioButton>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Checked="Nav_Checked" ToolTip="Einstellungen (Strg+,)">
                    <DockPanel>
                        <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Width="20" Margin="0,0,14,0"/>
                        <TextBlock Text="Einstellungen" VerticalAlignment="Center" Tag="wide"/>
                    </DockPanel>
                </RadioButton>
            </StackPanel>
        </Grid>

        <!-- ================= Inhalt: Fläche mit runder Ecke über Mica ================= -->
        <Border x:Name="ContentLayer" Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid x:Name="ContentRoot" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Update verfügbar (wie InfoBar) -->
                <Border x:Name="UpdateBar" Margin="28,16,28,0" Padding="14,10" CornerRadius="4" BorderThickness="1" Visibility="Collapsed"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16" Margin="2,0,14,0" VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="10" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock TextWrapping="Wrap">
                                <Run x:Name="UpdateTitle" FontWeight="SemiBold"/>
                                <Run Text="  "/>
                                <Run x:Name="UpdateSubtitle" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </TextBlock>
                            <ProgressBar x:Name="UpdateProgressBar" Height="4" Margin="0,8,0,2" Maximum="1" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel x:Name="UpdateButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="Was ist neu?" Style="{StaticResource LinkButton}" Click="UpdateNotes_Click" Margin="0,0,16,0"
                                    VerticalAlignment="Center"/>
                            <Button Content="Später" Click="UpdateLater_Click" Margin="0,0,8,0"/>
                            <Button Content="Jetzt aktualisieren" Style="{DynamicResource AccentButtonStyle}" Click="UpdateNow_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="Pages" Grid.Row="1">

                    <!-- ===== Sounds ===== -->
                    <Grid x:Name="SoundsPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="28,22,28,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sounds" Style="{StaticResource PageTitle}"/>
                                <TextBlock x:Name="SoundsSubtitle" Style="{StaticResource Secondary}" TextWrapping="NoWrap" Margin="1,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ImportBtn" Style="{DynamicResource AccentButtonStyle}" Click="Import_Click" Margin="0,0,8,0"
                                        ToolTip="Sound-Dateien oder einen Ordner importieren (Strg+O)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ImportLabel" Text="Importieren" Margin="8,0,0,0"/>
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="8,1,0,0"/>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Dateien auswählen …" InputGestureText="Strg+O" Click="ImportFiles_Click">
                                                <MenuItem.Icon><TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Ganzen Ordner importieren …" Click="ImportFolder_Click">
                                                <MenuItem.Icon><TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"/></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button x:Name="ViewBtn" Click="View_Click" ToolTip="Kachelgröße und Sound-Ordner">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ViewLabel" Text="Darstellung" Margin="8,0,0,0"/>
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="8,1,0,0"/>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="ViewMenu">
                                            <MenuItem x:Name="SizeSmall" Header="Kleine Kacheln" IsCheckable="True" Click="TileSize_Click" Tag="small"/>
                                            <MenuItem x:Name="SizeMedium" Header="Mittlere Kacheln" IsCheckable="True" Click="TileSize_Click" Tag="medium"/>
                                            <MenuItem x:Name="SizeLarge" Header="Große Kacheln" IsCheckable="True" Click="TileSize_Click" Tag="large"/>
                                            <Separator/>
                                            <MenuItem Header="Sound-Ordner im Explorer zeigen" Click="OpenFolder_Click">
                                                <MenuItem.Icon><TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}"/></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <!-- unten Platz für die schwebende Wiedergabeleiste -->
                                <ItemsControl x:Name="Tiles" ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource TilePanel}"
                                              Margin="28,2,28,96" Focusable="False"/>
                            </ScrollViewer>

                            <!-- Keine Sounds -->
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,80" Visibility="Collapsed">
                                <ContentControl x:Name="EmptyIcon" HorizontalAlignment="Center" Focusable="False"/>
                                <TextBlock Text="Keine Sounds" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,4"/>
                                <TextBlock Text="Zieh Sound-Dateien oder einen ganzen Ordner in dieses Fenster." HorizontalAlignment="Center"
                                           TextAlignment="Center" Style="{StaticResource Secondary}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <Button Style="{DynamicResource AccentButtonStyle}" Click="ImportFiles_Click" Content="Dateien importieren …"/>
                                    <Button Margin="8,0,0,0" Click="ImportFolder_Click" Content="Ordner importieren …"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Keine Treffer -->
                            <StackPanel x:Name="NoResults" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,80" Visibility="Collapsed">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="NoResultsText" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                                <TextBlock Text="Prüfe die Schreibweise oder such etwas anderes." HorizontalAlignment="Center" Style="{StaticResource Secondary}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ===== Lobby ===== -->
                    <ScrollViewer x:Name="LobbyPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False" Visibility="Collapsed">
                        <Grid>
                            <!-- Noch nicht in einer Lobby -->
                            <StackPanel x:Name="LobbySetup" MaxWidth="660" Margin="28,36,28,110">
                                <ContentControl x:Name="LobbyHeroIcon" HorizontalAlignment="Center" Focusable="False"/>
                                <TextBlock Text="Zusammen abspielen" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,18,0,6"/>
                                <TextBlock Style="{StaticResource Secondary}" FontSize="16" TextAlignment="Center" MaxWidth="500"
                                           Text="Jeder Sound, den jemand drückt, läuft bei allen in der Lobby gleichzeitig – egal ob Windows, Mac oder Browser. Ein Konto braucht man dafür nicht."/>

                                <Border Style="{StaticResource Card}" Margin="0,28,0,12" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE77B;" Style="{StaticResource Glyph}" FontSize="20" Margin="2,0,16,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Dein Name" FontWeight="SemiBold"/>
                                            <TextBlock Text="So sehen dich die anderen in der Lobby." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                            <TextBox x:Name="LobbyName" MaxLength="24"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}" Padding="20">
                                        <DockPanel>
                                            <ContentControl x:Name="OpenCardIcon" DockPanel.Dock="Top" HorizontalAlignment="Left" Focusable="False"/>
                                            <TextBlock DockPanel.Dock="Top" Text="Eigene Lobby öffnen" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,4"/>
                                            <Button x:Name="LobbyOpenBtn" DockPanel.Dock="Bottom" Content="Lobby öffnen" Style="{DynamicResource AccentButtonStyle}"
                                                    HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="LobbyOpen_Click"/>
                                            <TextBlock x:Name="LobbyOpenHint" Style="{StaticResource Secondary}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                                        <DockPanel>
                                            <ContentControl x:Name="JoinCardIcon" DockPanel.Dock="Top" HorizontalAlignment="Left" Focusable="False"/>
                                            <TextBlock DockPanel.Dock="Top" Text="Mit Code beitreten" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,8"/>
                                            <Button x:Name="LobbyJoinBtn" DockPanel.Dock="Bottom" Content="Beitreten" HorizontalAlignment="Stretch"
                                                    Margin="0,16,0,0" Click="LobbyJoin_Click" IsEnabled="False"/>
                                            <Grid>
                                                <TextBox x:Name="LobbyCode" MaxLength="5" CharacterCasing="Upper" FontFamily="{StaticResource MonoFont}"
                                                         FontSize="24" FontWeight="SemiBold" TextAlignment="Center" Padding="8,6"
                                                         KeyDown="LobbyCode_KeyDown" TextChanged="LobbyCode_TextChanged"/>
                                                <TextBlock x:Name="LobbyCodePlaceholder" Text="ABC12" FontFamily="{StaticResource MonoFont}" FontSize="24"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="LobbyError" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Style="{StaticResource Secondary}" Text="Der Server speichert keine Sounds – sie gehen direkt von Gerät zu Gerät."/>
                                </StackPanel>
                                <Button Content="Datenschutzerklärung" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                        Click="Privacy_Click"/>
                            </StackPanel>

                            <!-- In der Lobby -->
                            <StackPanel x:Name="LobbyInside" Margin="28,22,28,110" Visibility="Collapsed">
                                <TextBlock Text="Lobby" Style="{StaticResource PageTitle}"/>
                                <TextBlock x:Name="LobbyPeople" Style="{StaticResource Secondary}" Margin="1,0,0,18"/>

                                <Border Style="{StaticResource Card}" Padding="20">
                                    <StackPanel>
                                        <DockPanel>
                                            <ContentControl x:Name="LobbyHeadIcon" Margin="0,0,16,0" Focusable="False"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="LobbyTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Ellipse x:Name="LobbyStatusDot" Width="8" Height="8" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="LobbyStatus" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                        <WrapPanel Margin="0,18,0,0">
                                            <StackPanel x:Name="CodeBoxes" Orientation="Horizontal" Margin="0,0,24,8" ToolTip="Lobby-Code"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                                <Button Click="LobbyCopy_Click" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Code kopieren"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="LobbyLeave_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE89B;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                        <TextBlock Text="Verlassen" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="In der Lobby" Style="{StaticResource SectionTitle}"/>
                                <WrapPanel x:Name="MembersPanel"/>

                                <!-- Host: Freigabe und Hinweis -->
                                <Border x:Name="HostInfo" Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <StackPanel x:Name="UploadInfo">
                                            <DockPanel>
                                                <TextBlock x:Name="UploadText" DockPanel.Dock="Right" Style="{StaticResource Secondary}"/>
                                                <TextBlock Text="Sounds werden freigegeben"/>
                                            </DockPanel>
                                            <ProgressBar x:Name="UploadProgress" Height="4" Margin="0,8,0,14"/>
                                        </StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" VerticalAlignment="Top" Margin="0,2,12,0"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Style="{StaticResource Secondary}"
                                                       Text="Rechtsklick auf einen Sound → „Schenken an“, um ihn jemandem zu geben. Gäste können dich auch fragen – du entscheidest."/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Gast: Sounds des Hosts -->
                                <StackPanel x:Name="GuestSounds">
                                    <DockPanel Margin="0,24,0,10">
                                        <TextBlock x:Name="GuestSoundsCount" DockPanel.Dock="Right" Style="{StaticResource Secondary}" VerticalAlignment="Bottom"/>
                                        <TextBlock x:Name="GuestSoundsTitle" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    </DockPanel>
                                    <ItemsControl x:Name="LobbyTiles" ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource TilePanel}"
                                                  Focusable="False"/>
                                    <TextBlock x:Name="GuestEmpty" Style="{StaticResource Secondary}" TextAlignment="Center" Margin="0,40" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- ===== Konto & Clan (aus dem Code) ===== -->
                    <ContentControl x:Name="AccountHost" Focusable="False" Visibility="Collapsed"/>
                    <ContentControl x:Name="ClanHost" Focusable="False" Visibility="Collapsed"/>

                    <!-- ===== Einstellungen ===== -->
                    <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False" Visibility="Collapsed">
                        <StackPanel Margin="28,22,28,110" MaxWidth="1000">
                            <TextBlock Text="Einstellungen" Style="{StaticResource PageTitle}" Margin="0,0,0,8"/>

                            <TextBlock Text="Fenster" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}" CornerRadius="4">
                                <DockPanel>
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" Margin="4,0,20,0" DockPanel.Dock="Left"/>
                                    <CheckBox x:Name="KeepInTray" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right" VerticalAlignment="Center"
                                              Margin="16,0,0,0" Checked="KeepInTray_Changed" Unchecked="KeepInTray_Changed"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Beim Schließen im Infobereich weiterlaufen"/>
                                        <TextBlock x:Name="KeepInTrayHint" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="Sounds" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}" CornerRadius="4" Margin="0,0,0,4">
                                <DockPanel>
                                    <TextBlock Text="&#xE8A9;" Style="{StaticResource Glyph}" Margin="4,0,20,0" DockPanel.Dock="Left"/>
                                    <ComboBox x:Name="TileSizeBox" DockPanel.Dock="Right" MinWidth="140" VerticalAlignment="Center" Margin="16,0,0,0"
                                              SelectionChanged="TileSizeBox_Changed">
                                        <ComboBoxItem Content="Klein" Tag="small"/>
                                        <ComboBoxItem Content="Mittel" Tag="medium"/>
                                        <ComboBoxItem Content="Groß" Tag="large"/>
                                    </ComboBox>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Kachelgröße"/>
                                        <TextBlock Text="Wie groß die Sounds im Raster sind." Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" CornerRadius="4">
                                <DockPanel>
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" Margin="4,0,20,0" DockPanel.Dock="Left"/>
                                    <Button Content="Im Explorer öffnen" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" Click="OpenFolder_Click"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Sound-Ordner"/>
                                        <TextBlock x:Name="FolderText" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="Personalisierung" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}" CornerRadius="4">
                                <DockPanel>
                                    <Image x:Name="IconPreview" Width="40" Height="40" Margin="0,0,16,0" DockPanel.Dock="Left"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Button x:Name="ResetIcon" Content="Zurücksetzen" Click="ResetIcon_Click" Margin="0,0,8,0"/>
                                        <Button Content="Bild auswählen …" Click="ChooseIcon_Click"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="IconState" Text="App-Icon"/>
                                        <TextBlock Text="Gilt für Fenster, Taskleiste und Infobereich. Bild hier hineinziehen geht auch." Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="Info" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}" CornerRadius="4" Margin="0,0,0,4">
                                <DockPanel>
                                    <Image Source="AppIcon.ico" Width="24" Height="24" Margin="0,0,20,0" DockPanel.Dock="Left"/>
                                    <Button Content="Nach Updates suchen" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" Click="CheckUpdates_Click"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="VersionText" Text="ClipSound"/>
                                        <TextBlock Text="Soundboard für Windows, Mac, Linux, iPhone und Browser" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" CornerRadius="4">
                                <DockPanel>
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" Margin="4,0,20,0" DockPanel.Dock="Left"/>
                                    <Button Content="Datenschutzerklärung" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" Click="Privacy_Click"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Datenschutz"/>
                                        <TextBlock Text="Der Server speichert keine Sounds. Sie gehen direkt von Gerät zu Gerät." Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Beim Reinziehen -->
                <Border x:Name="DropOverlay" Grid.RowSpan="2" Margin="12" CornerRadius="8" BorderThickness="2" Visibility="Collapsed"
                        IsHitTestVisible="False" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                    <Grid>
                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.08" CornerRadius="6"/>
                        <Border Style="{StaticResource Floating}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="18" Margin="0,0,12,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="DropText" Text="Loslassen zum Importieren" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Kurze Meldung über der Wiedergabeleiste -->
                <Border x:Name="Toast" Grid.Row="1" Style="{StaticResource Floating}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="16,0,16,86" Padding="16,10" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"/>
                </Border>

                <!-- ===== Wiedergabeleiste (schwebt unten) ===== -->
                <Border x:Name="PlayerBar" Grid.Row="1" Style="{StaticResource Floating}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="16,0,16,18" Padding="6" MaxWidth="900">
                    <StackPanel Orientation="Horizontal" Height="40">
                        <!-- Lobby -->
                        <Button x:Name="LobbyChip" Style="{StaticResource SubtleButton}" Padding="12,0" Click="LobbyChip_Click"
                                ToolTip="Lobby öffnen" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LobbyChipDot" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LobbyChipCode" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="14,0,6,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="LobbyChipCount" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <Rectangle x:Name="LobbyChipDivider" Style="{StaticResource BarDivider}" Visibility="Collapsed"/>

                        <!-- Was gerade läuft -->
                        <StackPanel x:Name="NowPlaying" Orientation="Horizontal" Margin="6,0,10,0" Visibility="Collapsed">
                            <Border x:Name="NowPlayingIcon" Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center">
                                <TextBlock Text="&#xE995;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel x:Name="NowPlayingText" Width="160" Margin="10,0,0,0" VerticalAlignment="Center">
                                <DockPanel>
                                    <TextBlock x:Name="NowPlayingMore" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="NowPlayingTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <local:ProgressLine x:Name="NowPlayingProgress" Height="3" Margin="0,6,0,0"
                                                    Track="{DynamicResource ControlStrongFillColorDisabledBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Rectangle x:Name="NowPlayingDivider" Style="{StaticResource BarDivider}" Visibility="Collapsed"/>

                        <!-- Steuerung -->
                        <Button x:Name="StopBtn" Style="{StaticResource SubtleButton}" Width="40" Click="Stop_Click" ToolTip="Alles stoppen (Esc)" IsEnabled="False">
                            <TextBlock Text="&#xE71A;" Style="{StaticResource Glyph}"/>
                        </Button>
                        <ToggleButton x:Name="Overlap" Style="{StaticResource SubtleToggle}" Width="40" Margin="2,0,0,0"
                                      ToolTip="Überlappen: mehrere Sounds gleichzeitig abspielen (Strg+L)" Checked="Overlap_Changed" Unchecked="Overlap_Changed">
                            <TextBlock Text="&#xE81E;" Style="{StaticResource Glyph}"/>
                        </ToggleButton>
                        <Rectangle Style="{StaticResource BarDivider}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0" ToolTip="Lautstärke · Klick auf die Zahl = 100 %">
                            <TextBlock x:Name="SpeakerIcon" Text="&#xE995;" Style="{StaticResource Glyph}" Width="24" Padding="0,4"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Background="Transparent" MouseLeftButtonDown="SpeakerIcon_MouseDown"/>
                            <Slider x:Name="Volume" Width="120" Margin="8,0" Minimum="0" Maximum="5" SmallChange="0.05" LargeChange="0.25"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center" ValueChanged="Volume_Changed" Focusable="False"/>
                            <TextBlock x:Name="VolumeText" Text="80 %" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                       Cursor="Hand" MouseLeftButtonDown="VolumeText_Click"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3× auf den Lautsprecher: echte Lautstärke (in der Lobby: aller Geräte) -->
                <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=SpeakerIcon}" Placement="Top"
                       StaysOpen="False" AllowsTransparency="True" VerticalOffset="-14" HorizontalOffset="-140">
                    <Border Width="320" Padding="16" Margin="12" Style="{StaticResource Floating}">
                        <StackPanel>
                            <TextBlock x:Name="VolumePopupTitle" Text="Lautstärke der Geräte" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel x:Name="VolumeRows"/>
                            <TextBlock x:Name="VolumeHint" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- ================= Taste aufnehmen (wie ContentDialog) ================= -->
        <Grid x:Name="Recorder" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource SmokeFillColorDefaultBrush}"
              MouseLeftButtonDown="RecorderBackground_MouseDown">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                    MouseLeftButtonDown="DialogCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Border Padding="24" CornerRadius="8,8,0,0" Background="{DynamicResource LayerFillColorAltBrush}">
                        <StackPanel>
                            <TextBlock x:Name="RecorderTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="Drück eine Taste oder Kombination." Style="{StaticResource Secondary}" Margin="0,4,0,0"/>
                            <StackPanel x:Name="RecorderKeys" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" VerticalAlignment="Top" Margin="0,2,10,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Secondary}"
                                           Text="Mit Alt (z. B. Alt+2) oder Strg+Umschalt geht sie überall, auch wenn ClipSound im Hintergrund ist – z. B. in Spielen oder Discord."/>
                            </Grid>
                            <TextBlock x:Name="RecorderNote" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="24" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RemoveKeyBtn" Content="Taste entfernen" HorizontalAlignment="Stretch" Click="RemoveKey_Click"
                                    Focusable="False" ToolTip="Rücktaste"/>
                            <Button Grid.Column="2" Content="Fertig" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                    Click="RecorderDone_Click" Focusable="False" ToolTip="Esc"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Rückfrage / Meldung (wie ContentDialog) ================= -->
        <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource SmokeFillColorDefaultBrush}">
            <Border MaxWidth="460" MinWidth="320" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8"
                    BorderThickness="1" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Border Padding="24" CornerRadius="8,8,0,0" Background="{DynamicResource LayerFillColorAltBrush}">
                        <StackPanel>
                            <TextBlock x:Name="DialogTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock x:Name="DialogText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <PasswordBox x:Name="DialogPassword" Margin="0,16,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="24" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="DialogGap" Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DialogPrimary" HorizontalAlignment="Stretch" Click="DialogPrimary_Click"/>
                            <Button x:Name="DialogClose" Grid.Column="2" HorizontalAlignment="Stretch" Click="DialogClose_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
