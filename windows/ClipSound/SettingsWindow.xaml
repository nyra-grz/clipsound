<Window x:Class="ClipSound.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True">
    <StackPanel x:Name="Root" Margin="20">
        <TextBlock Text="Fenster" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Border Padding="16" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <CheckBox x:Name="KeepInTray" Content="Beim Schließen im Infobereich weiterlaufen"
                          Checked="KeepInTray_Changed" Unchecked="KeepInTray_Changed"/>
                <TextBlock x:Name="KeepInTrayHint" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="App-Icon" FontWeight="SemiBold" Margin="0,20,0,8"/>
        <Border Padding="16" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="IconPreview" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="IconState"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Bild auswählen …" Click="ChooseIcon_Click"/>
                            <Button x:Name="ResetIcon" Content="Zurücksetzen" Click="ResetIcon_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Gilt für Fenster, Taskleiste und Infobereich. Bild hier hineinziehen geht auch." TextWrapping="Wrap"
                           Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Button Content="Fertig" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Right" MinWidth="90"
                Margin="0,20,0,0" IsDefault="True" IsCancel="True" Click="Done_Click"/>
    </StackPanel>
</Window>
